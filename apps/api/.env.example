# --- Server ---
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# --- Database (docker-compose defaults) ---
DATABASE_URL="postgresql://energy_dashboard:energy_dashboard@localhost:5432/energy_dashboard?schema=public"

# --- Auth ---
# Random 32+ char string used to sign session JWTs.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 32-byte key (64 hex chars) used to encrypt stored third-party tokens at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# --- eWeLink Open Platform (https://dev.ewelink.cc) ---
# Register an app in the eWeLink Open Platform console to obtain these.
EWELINK_APP_ID=
EWELINK_APP_SECRET=
# One of: us, eu, as, cn — must match the region your eWeLink account was registered in.
EWELINK_REGION=us
# Must match a redirect URI registered for your eWeLink app.
EWELINK_REDIRECT_URI=http://localhost:4000/api/integrations/ewelink/callback

# --- Deye Cloud Open Platform (https://developer.deyecloud.com) ---
# Register an app in the Deye Cloud developer console to obtain these.
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_BASE_URL=https://eu1-developer.deyecloud.com
DEYE_REDIRECT_URI=http://localhost:4000/api/integrations/deye/callback

# --- Automation engine ---
# How often (ms) the automation worker polls device state and evaluates rules.
AUTOMATION_POLL_INTERVAL_MS=60000
